# Copy to .env and fill in. .env is gitignored and never committed.

# The wallet that holds collateral and owns every Uniswap/Swapr position.
# Used by every mutating script (37 of them). No default — a missing value
# fails deep inside ethers with an unhelpful null dereference.
PRIVATE_KEY=

# Optimism (chain 10) JSON-RPC. The busiest key in the repo: every
# originality, Zcash Q3, Zcash NU7 and L1 script reads it.
RPC_URL=

# Gnosis (chain 100) JSON-RPC. Only the PD market scripts use it:
# create-pd-market-gnosis.js, add-pd-liquidity-gnosis{,-round2,-v2}.js,
# remove-liquidity-gnosis.js.
GNOSIS_RPC_URL=

# Credora GraphQL key, for the probability-of-default snapshot.
# fetch-credora-pd.js only.
CREDORA_API=
